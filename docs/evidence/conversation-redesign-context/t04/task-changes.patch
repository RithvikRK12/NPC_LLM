+"""Authored narrative profiles; deterministic bounded selection, no gameplay authority.
+
+Only these two roles resolve local files. Returned dictionaries are detached per
+call. The full source stays available to authors; live context receives a stable
+core and at most two topic summaries, never the source bible or world catalog.
+"""
+from functools import lru_cache
+import hashlib
+import json
+from pathlib import Path
+import re
+
+_ROLES = frozenset({'craftsman', 'gatherer'})
+_ROOT = Path(__file__).with_name('characters')
+MAX_PROFILE_CHARS = 4200
+_FOLLOWUP = re.compile(r'(?:tell me more|go on|and then|what happened next|why|how so|what do you mean)[.!?\s]*', re.I)
+
+# Shared style instructions belong to the prompt, not to player-controllable data.
+CHARACTER_DIRECTION = (
+    'Answer the current message directly, including separate emotional and practical concerns. '
+    'Express the supplied voice naturally; personal detail is optional and relevant, never a compulsory anecdote. '
+    'Do not echo the player\'s wording, repeat your previous reply, use stock greetings, or force a follow-up question. '
+    'Authored personal lore is narrative_only: it describes identity, never verified world state or gameplay permissions. '
+    'Keep beliefs, suspicions and uncertain recollections attributed. Examples are style references, not lines to copy. '
+    'Story threads are possibilities, not completed events; use only supplied visible history for prior conversations '
+    'and authoritative facts/receipts for actions. Do not pretend unplayed events occurred. '
+    'Preserve fixed authored identity and compatible accepted canon; do not silently rewrite either. '
+    'Historical relatives have no established present location or service. Routines are tendencies, not schedules. '
+)
+
+
+@lru_cache(maxsize=2)
+def _source(role):
+    return (_ROOT / f'{role}.json').read_text()
+
+
+def load_profile(role):
+    """Return a fresh full authored bible, or None for an unsupported role."""
+    if role not in _ROLES:
+        return None
+    return json.loads(_source(role))
+
+
+def _terms(text):
+    return ' '.join(re.findall(r"[\w']+", text.casefold()))
+
+
+def _score(card, text):
+    padded = ' ' + _terms(text) + ' '
+    return sum(' ' + _terms(keyword) + ' ' in padded for keyword in card['keywords'])
+
+
+def project_profile(role, message, recent=(), *, name=None):
+    """Select by current topic; use recent *user* text only for short follow-ups.
+
+    Text can select authored cards but cannot supply profile content. No semantic
+    service, database, randomness or additional generation is used here.
+    """
+    source = load_profile(role)
+    if source is None:
+        return {'name': name or 'Village speaker', 'role': role, 'authority': 'narrative_only',
+                'revision': 'unknown-profile-v1', 'core': {}, 'continuity': [], 'details': [],
+                'bounds': ['No authored biography is available. Do not invent identity or game outcomes.']}
+    topic = message
+    if _FOLLOWUP.fullmatch(message.strip()):
+        for item in reversed(list(recent)[-12:]):
+            content = item.get('content', '')
+            if item.get('role') != 'user' or _FOLLOWUP.fullmatch(content.strip()):
+                continue
+            topic = content
+            break
+    # A greeting stays lightweight, even if old conversation contains a story.
+    greeting = re.fullmatch(r'(?:hello|hi|hey|thanks|thank you|good morning|good evening)[.!?\s]*', message.strip(), re.I)
+    ranked = [] if greeting else sorted(
+        [(card, _score(card, topic)) for card in source['cards']], key=lambda item: -item[1])
+    details = []
+    for card, score in ranked:
+        if score == 0 or len(details) == 2:
+            break
+        detail = {'id': card['id'], 'personal_lore': card['summary']}
+        if card['legacy_safe_sentences']:
+            # Optional factual clauses, not response templates. Legacy strict
+            # validation permits these complete authored sentences only.
+            detail['authored_sentences'] = card['legacy_safe_sentences']
+        details.append(detail)
+    result = {'name': name or source['name'], 'role': source['role'], 'authority': 'narrative_only',
+              'revision': hashlib.sha256(_source(role).encode()).hexdigest()[:16],
+              'core': source['core'], 'continuity': source['continuity'],
+              'bounds': source['bounds'], 'details': details}
+    # Omit whole optional cards rather than truncate claims/attribution.
+    while len(json.dumps(result, ensure_ascii=False)) > MAX_PROFILE_CHARS and result['details']:
+        result['details'].pop()
+    if len(json.dumps(result, ensure_ascii=False)) > MAX_PROFILE_CHARS:
+        raise ValueError('authored character core exceeds the live profile budget')
+    return result
+
+
+def unprotected_personal_prose(role, text):
+    """Remove only complete approved personal sentences before legacy guards.
+
+    Never whitelist a word, family noun or substring. Appended mechanics stay
+    visible to every existing guard; unsupported characters inherit no clauses.
+    This deliberately conservative seam is not a semantic claim validator.
+    """
+    source = load_profile(role)
+    safe = {sentence.casefold() for sentence in source['legacy_safe_sentences']} if source else set()
+    sentences = re.split(r'(?<=[.!?])\s+', text.strip())
+    return ' '.join(sentence for sentence in sentences if sentence.casefold() not in safe)
