# Local Llama playtest policy. These are provisional playtest bounds, not a
# claim that the release's language-quality or latency targets have passed.
LLM_MODEL=llama3:willowbrook
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_STRUCTURED_OUTPUT=true
LLM_TIMEOUT_SECONDS=60
CONVERSATION_ENABLED=true
CONVERSATION_POLICY_VERSION=local-playtest-v1
CONVERSATION_TOTAL_DEADLINE_SECONDS=180
CONVERSATION_PROVIDER_STAGE_BUDGET_SECONDS=60
CONVERSATION_CONTEXT_TOKEN_LIMIT=8192
CONVERSATION_GENERATION_TOKEN_LIMIT=2048
CONVERSATION_CONTRACT_JSON_CHAR_LIMIT=16384
CONVERSATION_OUTPUT_CHAR_LIMIT=600
CONVERSATION_BEAT_CHAR_LIMIT=300
CONVERSATION_QUEUE_CAPACITY=8
CONVERSATION_LEASE_DURATION_SECONDS=240
CONVERSATION_SUMMARY_TRIGGER_TURNS=20
CONVERSATION_MEMORY_RETRIEVAL_ENABLED=false
CONVERSATION_MEMORY_RETRIEVAL_TIMEOUT_SECONDS=3
CONVERSATION_MEMORY_RETRIEVAL_TOP_K=5
CONVERSATION_MEMORY_CANDIDATE_LIMIT=40
CONVERSATION_HISTORY_TURN_LIMIT=12
CONVERSATION_MEMORY_RETRIEVAL_ENABLED=false
CONVERSATION_MEMORY_RETRIEVAL_TIMEOUT_SECONDS=3
CONVERSATION_MEMORY_RETRIEVAL_TOP_K=5
CONVERSATION_MEMORY_CANDIDATE_LIMIT=40
CONVERSATION_HISTORY_TURN_LIMIT=12
CONVERSATION_DIAGNOSTIC_RETENTION_SECONDS=604800
CONVERSATION_DELIVERY_WAIT_SECONDS=1
CONVERSATION_WORKER_COUNT=2
CONVERSATION_WORKER_ID=local-playtest
