extends SceneTree
var failures := 0
func check(ok: bool, label: String) -> void:
	print("PASS " if ok else "FAIL ", label)
	if not ok: failures += 1
func _initialize() -> void:
	var source = load("res://scenes/cutscenes/opening/opening_director.gd")
	if source == null:
		check(false,"Opening director exists")
		quit(1)
		return
	var timing=load("res://resources/cutscenes/opening_timing.tres")
	check(timing.boundaries==PackedFloat32Array([0,6,22,28,30,33,39,43,49,57,60]),"Ten retained rebased shots")
	check(not timing.cue_ids.has("creak_1") and not timing.cue_ids.has("creak_2"),"Discarded lead-in cues removed")
	for rate in [1.0,2.0]:
		var d = source.new()
		d.start()
		for i in range(int(60.0 / rate * 60)): d.advance_clock(1.0/60,rate==2.0)
		check(is_equal_approx(d.time,60.0),"60 cinematic seconds at rate %s" % rate)
		check(d.events.filter(func(id): return not id.begins_with("creak_") and not id.begins_with("bird_") and not id.begins_with("step_") and not id.begins_with("cloth_")) == ["keel_contact","splinters","mast_break","deck_wash","player_fall","blackout","checkpoint","complete"],"Ordered cues and completion once")
		d.advance_clock(10,true)
		check(d.events.count("complete")==1,"Completion repeat safe")
		d.free()
	var d = source.new()
	d.start()
	d.advance_clock(20,false)
	d.advance_clock(20,true)
	check(d.time==60,"Mixed 20 + 20×2 run")
	d.start()
	d.advance_clock(1,true)
	d.advance_clock(1,false)
	check(d.time==3,"Release restores normal speed immediately")
	d.set_paused(true)
	d.advance_clock(10,true)
	check(d.time==3,"Pause freezes time")
	d.set_paused(false)
	d.set_focused(false)
	d.advance_clock(10,true)
	check(d.time==3,"Focus loss freezes time")
	d.set_focused(true)
	d.advance_clock(1,true)
	check(d.time==4,"Focus return requires fresh hold")
	d.advance_clock(0,false)
	d.advance_clock(1,true)
	check(d.time==6,"Fresh press restores acceleration")
	d.preview_shot(&"S06")
	check(d.time==33 and d.events.is_empty(),"Preview seek suppresses past side effects")
	d.advance_clock(3,false)
	check(d.events==["splinters","mast_break","deck_wash","player_fall"],"Seek dispatches only future cues")
	check(Engine.time_scale==1,"Global time scale unchanged")
	d.free()
	quit(1 if failures else 0)
